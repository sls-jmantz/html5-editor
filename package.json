{
  "name": "html5-visual-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8765",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev",
    "check:deploy": "wrangler deploy --dry-run",
    "test:deploy": "node --test tests/deployment.test.js",
    "check": "node --check script.js && node --check editor-core.js",
    "test": "node --test tests/core.test.js",
    "test:browser": "node --test tests/browser.test.js"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "wrangler": "4.152.0"
  }
}
