{
  "name": "html5-visual-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8765",
    "build": "node scripts/build.js",
    "package": "npm run build && node scripts/package.js",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "check": "node --check script.js && node --check editor-core.js",
    "test": "node --test tests/core.test.js",
    "test:browser": "npm run build && node --test tests/browser.test.js"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "wrangler": "^4.147.0"
  }
}
